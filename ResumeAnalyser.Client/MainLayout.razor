@inherits LayoutComponentBase

<div class="min-h-screen bg-[#0A0A0F] text-[#F1F5F9] font-sans antialiased overflow-x-hidden relative">
    <!-- Animated Particle Grid background -->
    <div class="fixed inset-0 pointer-events-none opacity-20 z-0 bg-grid-pattern"></div>
    <div class="fixed top-[-10%] left-[-10%] w-[50%] h-[50%] rounded-full bg-[#3B82F6] opacity-[0.03] blur-[150px] pointer-events-none z-0"></div>
    <div class="fixed bottom-[-10%] right-[-10%] w-[50%] h-[50%] rounded-full bg-[#6366F1] opacity-[0.03] blur-[150px] pointer-events-none z-0"></div>

    <header class="relative z-10 w-full border-b border-[#1C1C28] bg-[#0A0A0F]/80 backdrop-blur-md px-6 py-4 flex items-center justify-between">
        <a href="" class="flex items-center gap-3 group">
            <div class="w-8 h-8 rounded-lg bg-gradient-to-tr from-[#3B82F6] to-[#6366F1] flex items-center justify-center shadow-lg shadow-[#3B82F6]/20 transition-transform group-hover:scale-105 duration-300">
                <svg class="w-5 h-5 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                </svg>
            </div>
            <span class="font-syne font-bold text-lg tracking-wider text-white group-hover:text-[#3B82F6] transition-colors duration-300">RESUME<span class="text-[#3B82F6]">ANALYSER</span></span>
        </a>
        <div class="flex items-center gap-4">
            <span class="px-3 py-1 text-xs font-mono rounded-full border border-[#3B82F6]/20 bg-[#3B82F6]/5 text-[#3B82F6]">v1.0.0</span>
        </div>
    </header>

    <main class="relative z-10 w-full max-w-7xl mx-auto px-4 py-8 sm:px-6 lg:px-8">
        @Body
    </main>
</div>
